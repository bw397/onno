{
  "name": "onno",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.html --outdir=dist --splitting --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*' && bun scripts/build-workers.ts dist",
    "start": "NODE_ENV=production bun src/index.ts",
    "typecheck": "bun check",
    "test": "bun test"
  },
  "dependencies": {
    "assemblyscript": "^0.28.20",
    "monaco-editor": "^0.57.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fake-indexeddb": "^6.2.8"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
